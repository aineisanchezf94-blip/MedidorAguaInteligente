<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#162035"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvSeverityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRÍTICA"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="#FF5252" />

            <TextView
                android:id="@+id/tvTimestamp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hace 10 min"
                android:textColor="#8A99AD"
                android:textSize="12sp"
                android:gravity="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAlertTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alerta de Fuga de Agua"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvAlertDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Flujo continuo inusual detectado en la sección principal por más de 45 minutos."
            android:textColor="#8A99AD"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProcessAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejecutar: Cerrar Válvula Principal"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#FF5252"
            app:cornerRadius="10dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
